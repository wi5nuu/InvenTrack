# InvenTrack Enterprise Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=1433
DB_NAME=InvenTrackDB
DB_USER=sa
DB_PASSWORD=InvenTrack@2024!

# JWT Configuration
JWT_SECRET=YourSuperSecretKeyAtLeast32CharactersLong!
JWT_ISSUER=InvenTrack
JWT_AUDIENCE=InvenTrack.Client
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@inventrack.local

# Rate Limiting
API_RATE_LIMIT_PER_MINUTE=100
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# Import Settings
IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_BATCH_SIZE=100

# Docker
DOCKER_SQL_SA_PASSWORD=InvenTrack@2024!
