@using InvenTrack.Application.DTOs.Products
@using InvenTrack.Application.DTOs.Categories
@using InvenTrack.Application.DTOs.Suppliers
@model CreateProductDto
@{
    ViewData["Title"] = "Add Product";
    var categories = ViewBag.Categories as IEnumerable<CategoryDto>;
    var suppliers = ViewBag.Suppliers as IEnumerable<SupplierDto>;
}

<h1><i class="fas fa-plus-circle me-2"></i>Add Product</h1>

<div class="card shadow">
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">SKU</label>
                    <input asp-for="SKU" class="form-control" required />
                    <span asp-validation-for="SKU" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Product Name</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select" required>
                        <option value="">Select...</option>
                        @if (categories != null)
                        {
                            foreach (var c in categories.Where(x => x.IsActive))
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Supplier</label>
                    <select asp-for="SupplierId" class="form-select">
                        <option value="">Select...</option>
                        @if (suppliers != null)
                        {
                            foreach (var s in suppliers.Where(x => x.IsActive))
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Unit Price</label>
                    <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cost Price</label>
                    <input asp-for="CostPrice" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="CostPrice" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Initial Stock</label>
                    <input asp-for="StockQuantity" class="form-control" type="number" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Min Threshold</label>
                    <input asp-for="MinStockThreshold" class="form-control" type="number" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Unit</label>
                    <select asp-for="Unit" class="form-select">
                        <option>pcs</option>
                        <option>kg</option>
                        <option>liter</option>
                        <option>box</option>
                        <option>pack</option>
                        <option>spool</option>
                        <option>bag</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
                <a href="/Products" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
