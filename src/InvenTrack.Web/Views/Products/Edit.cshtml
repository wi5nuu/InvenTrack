@using InvenTrack.Application.DTOs.Products
@using InvenTrack.Application.DTOs.Categories
@using InvenTrack.Application.DTOs.Suppliers
@model ProductDto
@{
    ViewData["Title"] = "Edit Product";
    var categories = ViewBag.Categories as IEnumerable<CategoryDto>;
    var suppliers = ViewBag.Suppliers as IEnumerable<SupplierDto>;
}

<h1><i class="fas fa-edit me-2"></i>Edit Product: @Model.Name</h1>

<div class="card shadow">
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">SKU</label>
                    <input name="SKU" value="@Model.SKU" class="form-control" required />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Product Name</label>
                    <input name="Name" value="@Model.Name" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select name="CategoryId" class="form-select" required>
                        @if (categories != null)
                        {
                            foreach (var c in categories.Where(x => x.IsActive))
                            {
                                if (c.Id == Model.CategoryId)
                                {
                                    <option value="@c.Id" selected>@c.Name</option>
                                }
                                else
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Supplier</label>
                    <select name="SupplierId" class="form-select">
                        <option value="">Select...</option>
                        @if (suppliers != null)
                        {
                            foreach (var s in suppliers.Where(x => x.IsActive))
                            {
                                if (s.Id == Model.SupplierId)
                                {
                                    <option value="@s.Id" selected>@s.Name</option>
                                }
                                else
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Unit Price</label>
                    <input name="UnitPrice" value="@Model.UnitPrice" class="form-control" type="number" step="0.01" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cost Price</label>
                    <input name="CostPrice" value="@Model.CostPrice" class="form-control" type="number" step="0.01" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Min Threshold</label>
                    <input name="MinStockThreshold" value="@Model.MinStockThreshold" class="form-control" type="number" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Stock</label>
                    <input value="@Model.StockQuantity" class="form-control" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Unit</label>
                    <select name="Unit" class="form-select">
                        <option value="pcs" @(Model.Unit == "pcs" ? "selected" : "")>pcs</option>
                        <option value="kg" @(Model.Unit == "kg" ? "selected" : "")>kg</option>
                        <option value="liter" @(Model.Unit == "liter" ? "selected" : "")>liter</option>
                        <option value="box" @(Model.Unit == "box" ? "selected" : "")>box</option>
                        <option value="pack" @(Model.Unit == "pack" ? "selected" : "")>pack</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control" rows="2">@Model.Description</textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update</button>
                <a href="/Products" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
