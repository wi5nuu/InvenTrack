@using InvenTrack.Application.DTOs.Products
@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="fas fa-box me-2"></i>Products</h1>
    <div>
        <a href="/Products/Import" class="btn btn-info"><i class="fas fa-upload"></i> Import</a>
        <a href="/Products/Create" class="btn btn-primary"><i class="fas fa-plus"></i> Add Product</a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <form method="get" class="row g-3 mb-3">
            <div class="col-md-6">
                <input type="text" name="search" class="form-control" placeholder="Search by SKU, name, or category..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i> Search</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Supplier</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Value</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var product in Model.Items)
                        {
                            var rowClass = product.StockQuantity <= 0 ? "table-danger" :
                                product.StockQuantity <= product.MinStockThreshold ? "table-warning" : "";
                            <tr class="@rowClass">
                                <td><strong>@product.SKU</strong></td>
                                <td>@product.Name</td>
                                <td>@product.CategoryName</td>
                                <td>@(product.SupplierName ?? "-")</td>
                                <td class="text-end">@product.UnitPrice.ToString("C")</td>
                                <td class="text-end">
                                    @product.StockQuantity
                                    @if (product.IsLowStock)
                                    {
                                        <i class="fas fa-exclamation-circle text-warning ms-1" title="Low Stock"></i>
                                    }
                                </td>
                                <td class="text-end">@product.StockValue.ToString("C")</td>
                                <td>
                                    <a href="/Products/Edit/@product.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                    <form method="post" action="/Products/Delete/@product.Id" class="d-inline" onsubmit="return confirm('Delete @System.Web.HttpUtility.JavaScriptStringEncode(product.Name)?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center py-4">No products found.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
