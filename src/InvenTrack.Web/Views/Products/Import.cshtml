@{
    ViewData["Title"] = "Import Products";
}

<h1><i class="fas fa-upload me-2"></i>Import Products</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white"><i class="fas fa-file-upload"></i> Upload File</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data" action="/api/v1/import/upload" id="importForm">
                    <div class="mb-3">
                        <label class="form-label">Select CSV or Excel file</label>
                        <input type="file" name="file" class="form-control" accept=".csv,.xlsx" required />
                        <div class="form-text">Max file size: 10MB. Supported formats: .csv, .xlsx</div>
                    </div>
                    <button type="submit" class="btn btn-primary" id="uploadBtn">
                        <i class="fas fa-upload"></i> Upload & Import
                    </button>
                    <div class="mt-2">
                        <a href="/api/v1/import/template/csv" class="btn btn-sm btn-outline-secondary"><i class="fas fa-download"></i> CSV Template</a>
                        <a href="/api/v1/import/template/excel" class="btn btn-sm btn-outline-secondary"><i class="fas fa-download"></i> Excel Template</a>
                    </div>
                </form>
                <div id="uploadProgress" class="mt-3 d-none">
                    <div class="progress">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%">Processing...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white"><i class="fas fa-history"></i> Import History</div>
            <div class="card-body">
                <div id="importHistory">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function loadHistory() {
            try {
                const res = await fetch('/api/v1/import/jobs');
                const data = await res.json();
                if (data.success && data.data) {
                    let html = '<table class="table table-sm"><thead><tr><th>File</th><th>Status</th><th>Success</th><th>Failed</th><th>Date</th></tr></thead><tbody>';
                    data.data.forEach(job => {
                        html += `<tr>
                            <td>${job.fileName}</td>
                            <td><span class="badge bg-${job.status === 'Completed' ? 'success' : job.status === 'Failed' ? 'danger' : 'warning'}">${job.status}</span></td>
                            <td>${job.successRows}</td>
                            <td>${job.failedRows}</td>
                            <td>${new Date(job.createdAt).toLocaleDateString()}</td>
                        </tr>`;
                    });
                    html += '</tbody></table>';
                    document.getElementById('importHistory').innerHTML = html;
                }
            } catch (e) {
                document.getElementById('importHistory').innerHTML = '<p class="text-danger">Failed to load history</p>';
            }
        }

        document.getElementById('importForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            document.getElementById('uploadBtn').disabled = true;
            document.getElementById('uploadProgress').classList.remove('d-none');
            const formData = new FormData(this);
            try {
                const res = await fetch('/api/v1/import/upload', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    toastr.success('File uploaded. Import job queued.');
                    loadHistory();
                } else {
                    toastr.error(data.message || 'Upload failed');
                }
            } catch (err) {
                toastr.error('Upload failed');
            }
            document.getElementById('uploadBtn').disabled = false;
            document.getElementById('uploadProgress').classList.add('d-none');
        });

        loadHistory();
        setInterval(loadHistory, 10000);
    </script>
}
