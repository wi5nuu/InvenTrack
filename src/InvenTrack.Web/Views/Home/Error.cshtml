@model int?
@{
    ViewData["Title"] = Model switch
    {
        404 => "Page Not Found",
        403 => "Access Denied",
        500 => "Server Error",
        _ => "Error"
    };
    var message = Model switch
    {
        404 => "The page you are looking for does not exist.",
        403 => "You do not have permission to access this resource.",
        500 => "An unexpected error occurred. Please try again later.",
        _ => ViewBag.ErrorMessage ?? "An unexpected error occurred."
    };
}
<div class="text-center py-5">
    <h1 class="display-1 text-danger">@(Model ?? 500)</h1>
    <h2 class="text-muted mb-4">@ViewData["Title"]</h2>
    <p class="lead mb-4">@message</p>
    <a href="/Dashboard/Index" class="btn btn-primary btn-lg">
        <i class="fas fa-home me-2"></i> Go to Dashboard
    </a>
</div>
